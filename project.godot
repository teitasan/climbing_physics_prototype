; Engine configuration file.
; Generated for the climbing traversal prototype. No editor setup required.
config_version=5

[application]

config/name="Climbing Physics Prototype"
config/description="Third-person climbing traversal prototype for feel-testing ledge grab, hang, traverse, mantle, and jump grab."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InputSetup="*res://scripts/boot/input_setup.gd"

[display]

window/size/viewport_width=1680
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/vram_compression/import_etc2_astc=true
